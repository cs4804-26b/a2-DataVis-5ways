{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
        "url": "penglings.csv",
        "format": {
            "type": "csv"
        }
    },
    "mark": "point",
    "config": {
        "mark": {
            "invalid": "filter"
        }
    },
    "encoding": {
        "x": {
        "field": "flipper_length_mm",
        "type": "quantitative",
        "title": "Flipper Length (mm)",
        "scale": {"zero": false}
        },
        "y": {
        "field": "body_mass_g",
        "type": "quantitative",
        "title": "Body Mass (g)",
        "scale": {"zero": false}
        },
        "color": {
        "field": "species",
        "type": "nominal",
        "scale": {
            "domain": ["Adelie", "Chinstrap", "Gentoo"],
            "range": ["#0000ff", "#ff0000", "#00ff00"]
        }
        }
    }
}