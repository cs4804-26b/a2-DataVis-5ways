mu = 0.4
coverage.prob = mean((CIs[, 1] <= mu) & (mu <= CIs[, 2]))
coverage.prob
cor(cars[,1], cars[,2])
plot(cars[,1], cars[,2])
lines(lowess(cars[,1], cars[,2]))
cor.test(cars[,1], cars[,2])
